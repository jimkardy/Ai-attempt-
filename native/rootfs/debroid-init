#!/bin/sh
# Debroid guest init — runs inside the Debian trixie arm64 root filesystem that
# Debroid boots under User-Mode Linux (arch=um subarch=arm64).
#
# The kernel is started with `init=/sbin/debroid-init`, so this script replaces
# systemd on purpose: UML has no ACPI, no udev daemon and (in this build) a
# single guest CPU, and a plain init is what upstream UML images do too.
#
# Two jobs: bring up the pseudo filesystems, and grow the ext4 root to the size
# the VM reserved for it, then hand the console to an interactive shell.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mkdir -p /proc /sys /dev /dev/pts /tmp /run /dev/shm

echo
echo "Debroid guest — Debian $(cat /etc/debian_version 2>/dev/null) / $(uname -m)"
echo "kernel $(uname -sr) · $(nproc) cpu · $(awk '/MemTotal/ {print int($2/1024)" MB RAM"}' /proc/meminfo 2>/dev/null)"
echo

mount -t proc     proc     /proc    2>/dev/null || echo "[debroid] warning: /proc did not mount"
mount -t sysfs    sysfs    /sys     2>/dev/null || echo "[debroid] warning: /sys did not mount"
mount -t devtmpfs devtmpfs /dev     2>/dev/null || echo "[debroid] warning: devtmpfs did not mount"
mount -t devpts   devpts   /dev/pts 2>/dev/null || true
mount -t tmpfs    tmpfs    /tmp     2>/dev/null || true
mount -t tmpfs    tmpfs    /run     2>/dev/null || true
mount -t tmpfs    tmpfs    /dev/shm 2>/dev/null || true
chmod 1777 /tmp /run /dev/shm 2>/dev/null || true

hostname debroid 2>/dev/null || true

# The VM's disk image is as big as the disk size reserved in the app, but the
# filesystem inside it is only as big as the base image it was cloned from.
# Grow it to fill the whole disk, online: ext4 supports that on a mounted rw fs.
if [ -b /dev/ubda ]; then
    size=$(blockdev --getsize64 /dev/ubda 2>/dev/null || echo 0)
    echo "[debroid] root disk: /dev/ubda, $size bytes"
    echo "[debroid] growing the root filesystem to fill the disk…"
    if resize2fs /dev/ubda; then
        df -h / 2>/dev/null
    else
        echo "[debroid] resize2fs failed — continuing with the current filesystem size"
    fi
else
    echo "[debroid] warning: /dev/ubda not found; the root filesystem cannot be grown"
fi

echo
echo "You are root inside a real Linux kernel running as a normal Android app process."
echo "No root, no KVM, no hypervisor on the phone side. Type 'exit' to shut the guest down."
echo

# The kernel gave us the console on stdin/stdout, but re-opening /dev/console
# makes job control and line editing behave like a real tty.
if [ -c /dev/console ]; then
    exec </dev/console >/dev/console 2>&1
fi
exec /bin/bash --noprofile --norc -i
